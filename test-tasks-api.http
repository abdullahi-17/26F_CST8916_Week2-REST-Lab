# GET all tasks
GET http://localhost:8000/tasks
Accept: application/json

###

# GET a single task
GET http://localhost:8000/tasks/1
Accept: application/json

###

# CREATE a task
POST http://localhost:8000/tasks
Content-Type: application/json

{
  "title": "Complete CST8916 Assignment",
  "description": "Finish the REST API Assignment for CST8916",
  "user_id": 1,
  "completed": false
}

###

# UPDATE a task
PUT http://localhost:8000/tasks/1
Content-Type: application/json
  
{
  "title": "Complete CST8916 Assignment - Updated",
  "description": "Updated REST API Assignment",
  "completed": true
}

###

# DELETE a task
DELETE http://localhost:8000/tasks/2

###

# GET all tasks for a user
GET http://localhost:8000/users/1/tasks

###

# GET root URL
GET http://localhost:8000/
Accept: text/plain

###

# GET nonexistent task
GET http://localhost:8000/tasks/999
Accept: application/json

###

# CREATE task with missing fields
POST http://localhost:8000/tasks
Content-Type: application/json

{
  "title": "Incomplete Task"
}

###

# CREATE task with invalid user_id
POST http://localhost:8000/tasks
Content-Type: application/json  

{
  "title": "Task with Invalid User",
  "description": "This task has an invalid user_id",
  "user_id": 999,
  "completed": false
}

###

# UPDATE nonexistent task
PUT http://localhost:8000/tasks/999
Content-Type: application/json  

{
  "title": "Nonexistent Task Update",
  "description": "Trying to update a task that doesn't exist",
  "completed": true
}

###

# DELETE nonexistent task
DELETE http://localhost:8000/tasks/999 

###

# GET tasks for nonexistent user
GET http://localhost:8000/users/999/tasks
